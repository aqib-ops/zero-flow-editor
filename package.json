{
  "name": "zero-flow-editor",
  "version": "1.0.0",
  "private": true,
  "description": "Zero Flow — offline desktop video editor with real FFmpeg rendering",
  "author": {
    "name": "aqib-ops",
    "email": "aqib-ops@users.noreply.github.com"
  },
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n vite,electron -c cyan,magenta \"vite\" \"node scripts/dev-electron.mjs\"",
    "build": "vite build && node scripts/build-electron.mjs",
    "build:check": "tsc -p tsconfig.electron.json --noEmit && tsc --noEmit",
    "setup:binaries": "node scripts/setup-binaries.mjs",
    "setup:whisper": "node scripts/setup-whisper.mjs",
    "setup:fonts": "node scripts/setup-fonts.mjs",
    "setup": "npm run setup:binaries && npm run setup:whisper",
    "dist": "npm run build && electron-builder --win",
    "dist:publish": "npm run build && electron-builder --win --publish always",
    "preview": "vite preview",
    "start": "electron .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "electron": "^37.2.4",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.545.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.8.3",
    "vite": "^7.1.3"
  },
  "build": {
    "appId": "dev.zeroflow.editor",
    "productName": "Zero Flow",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/renderer/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "ffmpeg/**/*",
          "whisper/**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Zero Flow",
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "aqib-ops",
      "repo": "zero-flow-editor",
      "releaseType": "release"
    }
  }
}
